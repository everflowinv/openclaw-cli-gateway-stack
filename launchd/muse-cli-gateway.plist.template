<?xml version="1.0" encoding="UTF-8"?>
<!-- Keep in sync with muse-cli-gateway/install.py, which renders the same spec. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>MUSE_CLI_GATEWAY_MAX_CONCURRENT</key>
		<string>2</string>
		<key>MUSE_CLI_GATEWAY_PORT</key>
		<string>4571</string>
		<key>PATH</key>
		<string>__NODE_BIN_DIR__:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>__LABEL__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE_BIN__</string>
		<string>__REPO__/muse-cli-gateway/server.mjs</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__OPENCLAW_LOG_DIR__/muse-cli-gateway.stderr.log</string>
	<key>StandardOutPath</key>
	<string>__OPENCLAW_LOG_DIR__/muse-cli-gateway.stdout.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
</dict>
</plist>
